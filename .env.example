# Shared backend API origin. Include the /api suffix.
NEXT_PUBLIC_API_URL=https://staging-backend.contourna.com/api

# Authenticated product origin used by calls to action.
NEXT_PUBLIC_APP_URL=https://app.contourna.com

# Cloudflare Turnstile public site key for marketing hostnames.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Local development only. The backend bypass must also be enabled.
NEXT_PUBLIC_PLAYGROUND_BYPASS_TURNSTILE=false
